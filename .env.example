PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Transactional Source of Truth)
DATABASE_URL=postgresql://meterflow:meterflow_password@localhost:5432/meterflow_db?schema=public

# MongoDB Connection String (Raw Unstructured Usage Firehose)
MONGO_URI=mongodb://localhost:27017/meterflow_logs

# Redis Connection String (Rate Limits, Deduplication, BullMQ)
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Must be >= 16 characters in production)
JWT_SECRET=super_secret_production_jwt_signing_key_meterflow_2026
KEY_PEPPER=super_secret_crypto_pepper_for_api_key_hashing_meterflow

# CORS Config
CORS_ORIGIN=http://localhost:5173
