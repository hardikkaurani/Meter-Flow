// MeterFlow transactional schema (Postgres).
// Source of truth for orgs, users, APIs, keys, plans, and billing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  viewer
}

enum ApiEnvironment {
  development
  staging
  production
}

enum ApiStatus {
  active
  archived
}

enum KeyStatus {
  active
  revoked
}

enum BillingCycle {
  monthly
  yearly
}

enum InvoiceStatus {
  draft
  open
  paid
  void
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users       User[]
  apis        Api[]
  plans       Plan[]
  invoices    Invoice[]
  invitations Invitation[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([orgId])
}

model RefreshToken {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  replacedByToken  String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      UserRole @default(viewer)
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model Api {
  id              String         @id @default(cuid())
  orgId           String
  name            String
  description     String?
  upstreamBaseUrl String
  environment     ApiEnvironment @default(production)
  status          ApiStatus      @default(active)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoints    Endpoint[]
  apiKeys      ApiKey[]

  @@index([orgId])
}

model Endpoint {
  id          String   @id @default(cuid())
  apiId       String
  path        String
  method      String
  description String?
  costPerCall Decimal  @default(0) @db.Decimal(12, 6)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  api Api @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@index([apiId])
}

model ApiKey {
  id              String    @id @default(cuid())
  apiId           String
  keyHash         String    @unique // sha256(rawKey + pepper) — raw key never stored
  keyPrefix       String // first chars, shown in UI to identify a key
  status          KeyStatus @default(active)
  rateLimitPerMin Int       @default(60)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  api           Api            @relation(fields: [apiId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  usageRollups  UsageRollup[]

  @@index([apiId])
}

model UsageRollup {
  id             String   @id @default(cuid())
  apiKeyId       String
  date           DateTime @db.Date
  requests       Int      @default(0)
  errors         Int      @default(0)
  totalLatencyMs BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, date])
  @@index([apiKeyId])
}

model Plan {
  id            String       @id @default(cuid())
  orgId         String
  name          String
  pricePerUnit  Decimal      @default(0) @db.Decimal(12, 6)
  freeTierUnits Int          @default(0)
  billingCycle  BillingCycle @default(monthly)

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([orgId])
}

model Subscription {
  id                 String   @id @default(cuid())
  apiKeyId           String
  planId             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([planId])
}

model Invoice {
  id          String        @id @default(cuid())
  orgId       String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(draft)
  createdAt   DateTime      @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lineItems    InvoiceLineItem[]

  @@index([orgId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 6)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
